{
  "compilerOptions": {
    /* Node/Express üçün: commonjs, ts-node-dev ilə uyğun */
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["ES2020"],
    "types": ["node"],

    /* File Layout */
    "rootDir": "./src",
    "outDir": "./dist",

    /* Interop / module resolution */
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    /* Recommended */
    "strict": true,
    "skipLibCheck": true,

    /* "moduleResolution": "node" TS 6-da "node10" kimi adlandırılıb və
       köhnəlmiş sayılır, amma bizim commonjs backend üçün effektiv
       fərq yoxdur — xəbərdarlığı bilərəkdən susdururuq */
    "ignoreDeprecations": "6.0",

    /* Outputs (build üçün lazımdır, dev zamanı ts-node-dev bunları görməzdən gəlir) */
    "sourceMap": true,
    "declaration": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}